# ============================================================
# VAREX CI/CD PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your server
# ============================================================

# Network port (default: 3000)
PORT=3000

# Directory paths (optional: defaults to ./data and ./data/logs)
# DATA_DIR=/var/varex/data

# Security: JWT Secret Key (Leave empty to auto-generate a cryptographically secure 64-byte key)
# JWT_SECRET=your-secure-random-jwt-secret-string-at-least-32-chars

# Initial Main Administrator Account (Seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@varex.local
ADMIN_PASSWORD=ChangeThisPasswordOnFirstLogin!

# Server Sudo / Elevated Verification Password
# Used to authorize environment variable modifications and secrets editing
SERVER_SUDO_PASSWORD=your-secure-server-sudo-password
