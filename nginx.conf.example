# ============================================================
# VAREX CI/CD PLATFORM - NGINX REVERSE PROXY CONFIGURATION
# Location: /etc/nginx/sites-available/varex
# ============================================================

server {
    listen 80;
    server_name cicd.yourdomain.com; # Replace with your domain or server IP

    # Redirect all HTTP traffic to HTTPS (Recommended)
    # return 301 https://$host$request_uri;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3040;
        proxy_http_version 1.1;

        # WebSocket support (Crucial for live terminal output streaming)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forwarded headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-running deployments and builds
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
